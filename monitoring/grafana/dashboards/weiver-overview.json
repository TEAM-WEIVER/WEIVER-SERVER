    {
      "id": 10,
      "type": "timeseries",
      "title": "AI 대기 건수 (flow별)",
      "description": "각 서버가 같은 전체 값을 내므로 sum이 아니라 max로 묶는다. 30초마다 집계된 값이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "weiver-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
