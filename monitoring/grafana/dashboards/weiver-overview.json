      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "weiver-prometheus"
          },
          "refId": "A",
          "expr": "max by (queue) (rabbitmq_detailed_queue_messages_ready{queue=~\".*\\\\.queue\"})",
          "legendFormat": "{{queue}} ready"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "weiver-prometheus"
          },
          "refId": "B",
          "expr": "max by (queue) (rabbitmq_detailed_queue_messages_unacked{queue=~\".*\\\\.queue\"})",
          "legendFormat": "{{queue}} unacked"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "소비자 수",
      "description": "spring.* 큐는 Spring 서버, ai.* 큐는 AI 서버가 소비자다. 0이면 소비가 멈춘 상태다.",
      "datasource": {
        "type": "prometheus",
        "uid": "weiver-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
