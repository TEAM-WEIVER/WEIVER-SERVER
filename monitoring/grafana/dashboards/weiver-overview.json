{
  "uid": "weiver-overview",
  "title": "WEIVER 서버 개요",
  "tags": [
    "weiver"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "HTTP",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP 평균 지연 (uri별)",
      "description": "히스토그램이 꺼져 있어 백분위수(p95)는 없다. 평균과 최대값만 본다.",
      "datasource": {
        "type": "prometheus",
        "uid": "weiver-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "weiver-prometheus"
          },
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{application=\"weiver-backend\",uri!~\"/actuator.*\"}[5m])) / sum by (uri) (rate(http_server_requests_seconds_count{application=\"weiver-backend\",uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP 최대 지연 (uri별, 인스턴스 중 최대)",
      "description": "Micrometer max는 최근 구간(기본 2분)의 최대값이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "weiver-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "weiver-prometheus"
          },
          "refId": "A",
          "expr": "max by (uri) (http_server_requests_seconds_max{application=\"weiver-backend\",uri!~\"/actuator.*\"})",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP 오류율",
      "description": "전체 요청 중 오류 응답 비율(5분 rate). /actuator 경로는 뺀다.",
      "datasource": {
        "type": "prometheus",
        "uid": "weiver-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "weiver-prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"weiver-backend\",uri!~\"/actuator.*\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"weiver-backend\",uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "5xx"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "weiver-prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"weiver-backend\",uri!~\"/actuator.*\",status=~\"4..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"weiver-backend\",uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "4xx"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "RabbitMQ",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "큐 깊이 (ready / unacked)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "weiver-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
